# LivePi videosynth backend (show designer API + web UI).
# Install with scripts/install-backend-unit.sh, which fills in __APP_DIR__
# and __USER__ from .env and copies this to /etc/systemd/system/.
#
# No X/display dependency -- this is a plain LAN web service. The renderer
# (livepi-video-glitch.service) runs independently; the backend degrades
# gracefully (503 on commands, stale telemetry) when the renderer is down.

[Unit]
Description=LivePi Videosynth Backend
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__APP_DIR__/backend
# Two env files, later-wins for duplicate keys (systemd semantics). The
# in-repo one carries dev defaults; the per-device one on the writable
# data partition carries the secrets firstboot generated (LIVEPI_PASSWORD,
# LIVEPI_SECRET_KEY, LIVEPI_DATA_DIR) and overrides them. Both optional
# (leading '-'), so a dev Pi with no /data still starts fine.
EnvironmentFile=-__APP_DIR__/backend/.env
EnvironmentFile=-__DATA_DIR__/backend/.env
# --no-access-log: the per-request GET/POST log floods the (volatile) journal
# with the web UI's telemetry + param-preview traffic; warnings/errors still log.
ExecStart=__APP_DIR__/backend/.venv/bin/uvicorn livepi_backend.main:app --host 0.0.0.0 --port 8080 --no-access-log --log-level warning
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
