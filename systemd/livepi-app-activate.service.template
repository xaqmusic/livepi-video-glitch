# Template for /etc/systemd/system/livepi-app-activate.service -- rendered by
# scripts/provision-appliance.sh. Runs the in-app updater's `boot` step BEFORE
# the renderer/backend: it guarantees /data/app/current points at a bootable app
# tree and rolls an un-confirmed trial version back to last-good if it boot-loops
# (see scripts/app-activate.sh). Without this the app units would start against a
# possibly-dangling /data/app/current.
#
# ExecStart is the FACTORY copy (/opt/livepi) on purpose: this is the rollback
# machinery, so it must live on the immutable image, not the swappable tree.

[Unit]
Description=LivePi app activation (heal + roll back /data/app/current)
# dataprep mounts + grows /data on first boot; order after it so /data/app lands
# on the real partition. Order BEFORE the two units that run the swappable tree:
# they resolve /data/app/current, which this unit creates, so it must exist first.
After=livepi-dataprep.service local-fs.target
Before=livepi-backend.service livepi-video-glitch.service
# Deliberately NOT gated on /data being mounted: if the partition is missing the
# activator still runs and points current -> the factory app (on the volatile
# overlay), so the app units never start against a dangling path -> the box
# always renders. `boot` is idempotent and self-healing (scripts/app-activate.sh).

[Service]
Type=oneshot
RemainAfterExit=yes
# Root: writes symlinks under /data/app. LIVEPI_APP_USER lets it hand the
# upload-staging dir to the backend's account so the web UI can drop bundles there.
Environment=LIVEPI_FACTORY_DIR=__FACTORY_DIR__
Environment=LIVEPI_DATA_DIR=__DATA_DIR__
Environment=LIVEPI_APP_USER=__APP_USER__
ExecStart=__FACTORY_DIR__/scripts/app-activate.sh boot

[Install]
WantedBy=multi-user.target
