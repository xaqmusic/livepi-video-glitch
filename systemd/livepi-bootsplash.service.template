# Template for /etc/systemd/system/livepi-bootsplash.service -- rendered by
# scripts/provision-appliance.sh.
#
# Puts the owner's splash image on the framebuffer as early as the filesystem
# allows, with a "LivePi is booting" spinner under it, and stops once the
# renderer has drawn its first frame. X then takes over the SAME VT with
# -background none, so the image survives the handover rather than blanking.
# See scripts/livepi-bootsplash.sh.

[Unit]
Description=LivePi boot progress bar
DefaultDependencies=no
# As early as there is a console to draw on: the whole point is covering the
# long quiet stretch BEFORE the app-level services come up.
After=local-fs.target
Before=livepi-video-glitch.service
Conflicts=shutdown.target

[Service]
Type=simple
Environment=LIVEPI_BOOT_TTY=/dev/tty1
# Explicit, not inferred: the script resolves the owner's splash from the SAME
# config the renderer reads (ui.splash_image), which means it needs to know both
# where the app tree is and where user data lives.
Environment=LIVEPI_APP_DIR=__APP_DIR__
Environment=LIVEPI_DATA_DIR=__DATA_DIR__
EnvironmentFile=-__DATA_DIR__/backend/.env
ExecStart=__APP_DIR__/scripts/livepi-bootsplash.sh
# It exits on its own once the renderer's first frame lands. If the renderer
# never comes up, the script's own ceiling ends it -- a stuck progress bar must
# not become a second failure to debug.
TimeoutStartSec=150
StandardOutput=null
StandardError=journal

[Install]
WantedBy=sysinit.target
