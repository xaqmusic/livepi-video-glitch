# Template for /etc/systemd/system/livepi-video-glitch.service -- rendered
# and installed by scripts/install-systemd-unit.sh, which fills in the
# account and repo path below and requires no manual editing. See
# docs/deploy.md for the full setup (X11 kiosk session, group permissions,
# disabling any conflicting auto-login desktop).

[Unit]
Description=LivePi VideoGlitcher (kiosk)
# data.mount (the /data partition): the renderer reads shows/clips AND the
# "claimed" marker from /data at startup, so it must not start before /data is
# mounted -- otherwise it greets an already-claimed box with the setup card and
# the default show until things hot-reload. Order-only (After, not Requires), so
# a box that somehow has no /data still boots to a usable render. local-fs pulls
# data.mount into the boot transaction (nofail), so ordering after it is enough.
After=sound.target network.target data.mount

[Service]
Type=simple
WorkingDirectory=__APP_DIR__
# Picks up LIVEPI_DATA_DIR so the renderer reads shows/clips from the writable
# /data partition (the same per-device .env the backend loads). Optional
# (leading '-'): a dev Pi with no /data has it unset, and the renderer falls
# back to bin/data -- see src/util/DataPath.h. Shaders/config always stay on
# the app tree (bin/data), never /data.
EnvironmentFile=-__DATA_DIR__/backend/.env
# Read-only root: startx writes its MIT-MAGIC-COOKIE to $XAUTHORITY, which
# defaults to ~/.Xauthority -- on the RO root, so X can't authenticate and the
# kiosk never comes up. Point it at a tmpfs runtime dir systemd creates + owns
# for us (/run/livepi, mode 0700, User=). (Xorg's own /var/log logfile write
# also fails on RO root but is non-fatal -- it falls through to the journal;
# the image mounts journald volatile anyway.)
RuntimeDirectory=livepi
Environment=XAUTHORITY=/run/livepi/Xauthority
ExecStart=startx __APP_DIR__/bin/livepi-video-glitch -- -s off -dpms
# Restart=always, NOT on-failure: the main process is startx, which exits 0
# when its X session ends no matter how the app inside died -- a crash or a
# watchdog abort reads as "success" and on-failure would leave the kiosk
# down (exactly what happened on the first real power cycle). This is a
# gig appliance: if the picture ever stops, put it back.
Restart=always
RestartSec=3
User=__PI_USER__
Group=__PI_USER__
SupplementaryGroups=video render audio

[Install]
WantedBy=multi-user.target
